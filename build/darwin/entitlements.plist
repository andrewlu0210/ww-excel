<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime: WKWebView runs its JIT in its own process, so
         no JIT entitlement is needed. The app is not sandboxed: it opens
         files from anywhere, reads fonts through CoreText and checks
         GitHub for updates. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
</dict>
</plist>
