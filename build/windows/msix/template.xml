<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ww-excel"
        Arguments=""
        InstallLocation="C:\Program Files\WW\WW Excel">
    </Installer>
    <PackageInformation
        PackageName="WW Excel"
        PackageDisplayName="WW Excel"
        PublisherName="CN=WW"
        PublisherDisplayName="WW"
        Version="0.1.0.0"
        PackageDescription="Spreadsheet app for macOS">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ww.excel"
                Description="Spreadsheet app for macOS"
                DisplayName="WW Excel"
                ExecutableName="ww-excel"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WW Excel</DisplayName>
            <PublisherDisplayName>WW</PublisherDisplayName>
            <Description>Spreadsheet app for macOS</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ww-excel.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
